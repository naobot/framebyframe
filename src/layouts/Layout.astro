---
import Header from "../components/Header.astro";
import { counterpartPath, getLang } from '../i18n';
import '../styles/styles.scss';

interface Props {
  title?: string;
}

const { title } = Astro.props;

const SITE_NAME = 'コマ送り - Frame by Frame';
const lang = getLang(Astro.url);
const other = counterpartPath(Astro.url);
---

<!doctype html>
<html lang={lang === 'en' ? 'en' : 'ja'}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New&display=swap" rel="stylesheet">

		<meta name="generator" content={Astro.generator} />

		<link rel="alternate" hreflang={lang} href={Astro.url.pathname} />
		<link rel="alternate" hreflang={lang === 'en' ? 'ja' : 'en'} href={other} />

		<title>{title ? `${title} | ${SITE_NAME}` : SITE_NAME}</title>
	</head>
	<body>
		<Header slot="header" />
		<div id="container">
  		<main>
				<slot />
			</main>
		</div>
	</body>
</html>
