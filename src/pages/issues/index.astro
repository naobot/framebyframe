---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const issues = await getCollection('issues', ({ data }) => data.published !== false);
const sorted = issues.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)).reverse();

const issuesWithContent = await Promise.all(
  sorted.map(async (issue) => {
    const { Content } = await render(issue);
    return { issue, Content };
  })
);
---

<Layout title="Issues">
  <div id="issues-content">
    <div class="wrapper">
      <h1>Issues</h1>
      <main>
        <div class="issues-list">
          {issuesWithContent.map(({ issue, Content }) => (
            <div class="issue-item">
              <div class="feature-image">
                {(() => {
                  const slides = issue.data.photos?.length
                    ? issue.data.photos.map((p: { image: string }) => p.image)
                    : issue.data.cover
                      ? [issue.data.cover]
                      : [];

                  return slides.length > 0 && (
                    <>
                      <div
                        class="cover-carousel"
                        data-slides={JSON.stringify(slides)}
                      >
                        <img class="carousel-img carousel-img--a active" src={slides[0]} alt={issue.data.title} />
                        <img class="carousel-img carousel-img--b" src={slides[1] ?? slides[0]} alt={issue.data.title} />
                      </div>
                      {slides.length > 1 && (
                        <div class="carousel-dots">
                          {slides.map((_: string, i: number) => (
                            <span class={`carousel-dot${i === 0 ? ' active' : ''}`} />
                          ))}
                        </div>
                      )}
                    </>
                  );
                })()}
              </div>
              <div class="issue-description">
                {/*<a href={`/issues/${issue.slug}`}>*/}
                  <h2 class="issue-title">{issue.data.title}</h2>
                {/*</a>*/}
                <div class="issue-description-details">
                  <Content />
                </div>
                <div class="issue-sample-pages">
                  {issue.data.sample_pages?.length && issue.data.sample_pages?.length > 0 && (
                    <button
                      class="sample-pages-trigger"
                      data-images={JSON.stringify(issue.data.sample_pages.map((p: { image: string }) => p.image))}
                    >
                      サンプル画像はこちら
                    </button>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </main>
    </div>
  </div>

  <!-- Single shared lightbox overlay -->
  <div id="lightbox" aria-modal="true" role="dialog" aria-hidden="true">
    <button id="lightbox-close" aria-label="Close">✕</button>
    <button id="lightbox-prev" aria-label="Previous">&#8249;</button>
    <div id="lightbox-image-wrap">
      <img id="lightbox-img" src="" alt="Sample page" />
    </div>
    <button id="lightbox-next" aria-label="Next">&#8250;</button>
    <div id="lightbox-counter"></div>
  </div>
</Layout>

<style>
  #issues-content {
    margin: 180px 0 0 0;
    width: 100%;
    justify-content: center;
  }

  .wrapper {
    display: flex;
    flex-direction: column;
    margin: 0 2rem;
    align-items: center;
  }

  .issues-list {
    display: flex;
    flex-direction: column;
    width: 90vw;
    max-width: 960px;
    gap: 24px;
    margin: 20px auto;
  }

  .issue-item {
    display: flex;

    img {
      display: block;
      width: 100%;
      height: auto;
    }
  }

  .issue-description-details {
    h1 { font-size: 1.5rem; }
    h2 {
      font-size: 1.2rem;
      letter-spacing: 8px;
      background: #eeeeeeff;
      width: fit-content;
      padding: 0 16px;
    }
  }

  .issue-description {
    background: #fff;
    padding: 2rem;
    width: 50%;
  }

  .issue-sample-pages {
    display: flex;
    justify-content: center;
  }

  .issue-item a {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  /* ── trigger button ── */
  .sample-pages-trigger {
    background: yellow;
    padding: 0 8px;
    font-weight: 800;
    border: none;
    cursor: pointer;
    font-size: inherit;
    font-family: inherit;
  }

  /* ── lightbox ── */
  #lightbox {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    z-index: 1000;
    align-items: center;
    justify-content: center;
  }

  #lightbox[aria-hidden="false"] {
    display: flex;
  }

  #lightbox-image-wrap {
    max-width: 80vw;
    max-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #lightbox-img {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
    display: block;
  }

  #lightbox-close {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    background: none;
    border: none;
    color: #fff;
    font-size: 2rem;
    cursor: pointer;
    line-height: 1;
  }

  #lightbox-prev,
  #lightbox-next {
    background: none;
    border: none;
    color: #fff;
    font-size: 4rem;
    cursor: pointer;
    padding: 0 1rem;
    line-height: 1;
    user-select: none;
  }

  #lightbox-counter {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    color: #fff;
    font-size: 0.9rem;
    opacity: 0.7;
  }

  /* ── carousel ── */
  .feature-image {
    position: relative;
    overflow: visible;
    width: 50%;
    aspect-ratio: 3 / 4;
  }

  .cover-carousel {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .carousel-img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    opacity: 0;
    transition: opacity 0.6s ease-in-out;
  }

  .carousel-img.active {
    opacity: 1;
  }

  .carousel-dots {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 6px;
    z-index: 1;
  }

  .carousel-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    transition: background 0.2s;
  }

  .carousel-dot.active {
    background: #fff;
  }
</style>

<script>
  const lightbox = document.getElementById('lightbox')!;
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const counter = document.getElementById('lightbox-counter')!;

  let images: string[] = [];
  let current = 0;

  function show(index: number) {
    current = (index + images.length) % images.length;
    img.src = images[current];
    counter.textContent = `${current + 1} / ${images.length}`;
  }

  function open(imageList: string[]) {
    images = imageList;
    show(0);
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    img.src = '';
    images = [];
  }

  // Trigger buttons
  document.querySelectorAll<HTMLButtonElement>('.sample-pages-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const imageList = JSON.parse(btn.dataset.images ?? '[]') as string[];
      if (imageList.length) open(imageList);
    });
  });

  document.getElementById('lightbox-close')!.addEventListener('click', close);
  document.getElementById('lightbox-prev')!.addEventListener('click', () => show(current - 1));
  document.getElementById('lightbox-next')!.addEventListener('click', () => show(current + 1));

  // Close on backdrop click (not on the inner controls)
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) close();
  });

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (lightbox.getAttribute('aria-hidden') === 'true') return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });

  // Cover carousels
  document.querySelectorAll<HTMLElement>('.cover-carousel').forEach((carousel) => {
    const slides = JSON.parse(carousel.dataset.slides ?? '[]') as string[];
    if (slides.length <= 1) return;

    const imgA = carousel.querySelector<HTMLImageElement>('.carousel-img--a')!;
    const imgB = carousel.querySelector<HTMLImageElement>('.carousel-img--b')!;
    const dots = carousel.closest<HTMLElement>('.feature-image')!
      .querySelectorAll<HTMLElement>('.carousel-dot');
    let current = 0;
    let aIsActive = true;

    function goTo(index: number) {
      dots[current].classList.remove('active');
      current = (index + slides.length) % slides.length;
      dots[current].classList.add('active');

      const incoming = aIsActive ? imgB : imgA;
      const outgoing = aIsActive ? imgA : imgB;

      incoming.src = slides[current];
      incoming.classList.add('active');
      outgoing.classList.remove('active');
      aIsActive = !aIsActive;
    }

    setInterval(() => goTo(current + 1), 3000);
  });
</script>