---
import Layout from '../../layouts/Layout.astro';
import ActionButton from '../../components/ActionButton.astro';
import contributeData from '../../data/contribute.json';
import { marked } from 'marked';

const descriptionHtml = contributeData.description
  ? marked.parse(contributeData.description)
  : null;
---

<Layout title="About">
  <div class="about-page">
    <div id="page-content">
      <div class="wrapper">
        <!-- <div class="lang-toggle">
          <button id="btn-jp" class="active">JP</button>
          /
          <button id="btn-en">EN</button>
        </div> -->

        {contributeData.title && (
          <h1 class="heading jp">{ contributeData.title }</h1>
        )}
        {/*{section.heading_en && (
          <h2 class="heading en" aria-hidden="true">{ section.heading_en }</h2>
        )}*/}

        {contributeData.subtitle && (
          <h2 class="subheading jp">{ contributeData.subtitle }</h2>
        )}

        <div class="sections">
          {contributeData &&
            <section class="contribute-section">

              {descriptionHtml && (
                <div class="text jp" set:html={descriptionHtml} />
              )}
              {/*{section.text_en && (
                <div class="text en" aria-hidden="true" >
                  <p set:html={section.text_en} />
                </div>
              )}*/}

              {contributeData.contribution_link && contributeData.contribution_button && (
                <div class="contribute-link">
                  <ActionButton>
                    <a href={contributeData.contribution_link}>{ contributeData.contribution_button }</a>
                  </ActionButton>
                </div>
              )}

              <div>
                内容を確認の上、折り返しご連絡いたします。
              </div>
            </section>
          }
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const btnJp = document.getElementById('btn-jp');
  const btnEn = document.getElementById('btn-en');

  function setLang(lang: 'jp' | 'en') {
    const show = lang === 'jp' ? 'jp' : 'en';
    const hide = lang === 'jp' ? 'en' : 'jp';

    document.querySelectorAll<HTMLElement>(`.${show}`).forEach(el => {
      el.style.display = '';
      el.removeAttribute('aria-hidden');
    });
    document.querySelectorAll<HTMLElement>(`.${hide}`).forEach(el => {
      el.style.display = 'none';
      el.setAttribute('aria-hidden', 'true');
    });

    btnJp?.classList.toggle('active', lang === 'jp');
    btnEn?.classList.toggle('active', lang === 'en');
  }

  btnJp?.addEventListener('click', () => setLang('jp'));
  btnEn?.addEventListener('click', () => setLang('en'));

  // Initialise: hide EN elements on load
  setLang('jp');
</script>

<style>
  .lang-toggle {
    display: flex;
    gap: 0.5rem;
    padding: 16px;
  }

  .lang-toggle button {
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    font-weight: 300;
  }

  .lang-toggle button.active {
    font-weight: 800;
  }

  #page-content {
    margin: 180px 0 0 0;
    width: 100%;
    justify-content: center;
  }

  .wrapper {
    display: flex;
    flex-direction: column;
    margin: 0 2rem;
    align-items: center;
  }

  .sections {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 20px auto;
  }

  section {
    background: white;
    width: 90vw;
    max-width: 600px;
    padding: 2rem;

    h1:not(.heading) {
      font-weight: 800;
      font-size: 1.4em;
      margin-bottom: 8px;
    }

    h3:not(.subheading) {
      font-weight: 800;
      font-size: 1em;
      margin-top: 0;
      color: #797979ff;
    }

    p {
      white-space: pre-wrap;
    }
  }

  h1, h2, h3 {
    text-align: center;
    margin: 0;
  }

  h2 {
    font-size: 1em;
    font-weight: 800;
  }

  .contribute-link {
    text-align: center;
    margin: 20px 0;
  }
</style>