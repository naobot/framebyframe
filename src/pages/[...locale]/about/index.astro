---
import Layout from '../../../layouts/Layout.astro';
import aboutData from '../../../data/about.json';
import { getLang, localePaths, t } from '../../../i18n';

export const getStaticPaths = localePaths;

const lang = getLang(Astro.url);
const sections = aboutData.sections ?? [];
---

<Layout title="About">
  <div class="about-page">
    <div id="page-content">
      <div class="wrapper">
        <div class="sections">
          {sections.map((section) => {
            const heading = t(section, 'heading', lang);
            const subheading = t(section, 'subheading', lang);
            const text = t(section, 'text', lang);

            return (
              <section class="about-section">
                {heading && <h2 class="heading">{heading}</h2>}
                {subheading && <h3 class="subheading">{subheading}</h3>}
                {text && (
                  <div class="text">
                    <p set:html={text} />
                  </div>
                )}
              </section>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  #page-content {
    margin: 180px 0 0 0;
    width: 100%;
    justify-content: center;
  }

  .wrapper {
    display: flex;
    flex-direction: column;
    margin: 0 2rem;
    align-items: center;
  }

  .sections {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 20px auto;
  }

  section {
    background: white;
    width: 90vw;
    max-width: 600px;
    padding: 2rem;

    h1:not(.heading) {
      font-weight: 800;
      font-size: 1.4em;
      margin-bottom: 8px;
    }

    h3:not(.subheading) {
      font-weight: 800;
      font-size: 1em;
      margin-top: 0;
      color: #797979ff;
    }

    p {
      white-space: pre-wrap;
    }
  }

  h1, h2, h3 {
    text-align: center;
  }

  h2, h3 {
    margin: 0;
  }

  h2 {
    font-size: 2em;
    font-weight: 800;
  }
  h3 {
    font-size: 0.8em;
    font-weight: 300;
  }
</style>
