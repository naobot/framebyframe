---
import newsData from '../data/news.json';
const { items } = newsData;
---

<section id="news">
  <div>
    <h2>News</h2>
  </div>

  <div>
    {items.map((newsItem) => {
      const formattedDate = (() => {
        const date: string[] = []

        newsItem.year && date.push(newsItem.year)
        newsItem.month && date.push(newsItem.month)
        newsItem.day && date.push(newsItem.day)

        return date.join('.')
      })()

      return (
        <div class="news-row">
          <span>{formattedDate}</span>
          <span class="dots"></span>
          <span>{newsItem.title}</span>
        </div>
      )
    })}
  </div>
</section>

<style>
  #news {
    display: flex;
    flex-direction: column;
    padding: 1rem 2rem;

    .news-row {
      display: flex;
      align-items: baseline;
      margin: 1rem 0;
    }

    .dots {
      flex-grow: 1;
      border-bottom: 2px dotted #000;
      margin: 0 10px;
    }
  }
</style>