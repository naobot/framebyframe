---
import newsData from '../data/news.json';
const { items } = newsData;
---

<section id="news">
  <div>
    <h2>News</h2>
  </div>

  <div>
    {items.map((newsItem) => {
      const formattedDate = (() => {
        const date: string[] = []

        newsItem.year && date.push(newsItem.year)
        newsItem.month && date.push(newsItem.month)
        newsItem.day && date.push(newsItem.day)

        return date.join('.')
      })()

      return (
        <div>
          {formattedDate} {newsItem.title}
        </div>
      )
    })}
  </div>
</section>

<style>
  #news {
    display: flex;
    flex-direction: column;
    padding: 1rem 2rem;
  }


</style>