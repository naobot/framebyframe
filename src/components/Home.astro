---
import Hero from './Hero.astro';
import News from './News.astro';
import { getCollection } from 'astro:content';

const issues = await getCollection('issues', ({ data }) => data.published !== false);
const latestIssue = issues.at(-1);
// console.log(issues);
---

<Fragment>
  <Hero
    heading={latestIssue?.data.title}
    description={latestIssue?.data.description}
    cover={latestIssue?.data.cover}
    ctaHref="/issues"
  />
  <News />
</Fragment>