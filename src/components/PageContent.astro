---
const { title } = Astro.props;
---

<div id="page-content">
  <div class="wrapper">
    <h1>
      {title}
    </h1>

    <section id="content">
      <slot name="content" />
    </section>
  </div>
</div>

<style>
  #page-content {
    margin: 180px 0 0 0;
    width: 100%;
    justify-content: center;
  }

  .wrapper {
    display: flex;
    flex-direction: column;
    margin: 0 2rem;
    align-items: center;
  }

  #content {
    background: white;
    width: 90vw;
    max-width: 600px;
    padding: 2rem;
  }

  h1 {
    text-align: center;
  }
</style>