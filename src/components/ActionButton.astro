---
const { class: className, ...rest } = Astro.props;
---

<button class:list={['btn', className]} {...rest}>
  <slot />
</button>

<style>
  button {
    background: yellow;
    padding: 0 8px;
    font-weight: 800;
    border: none;
    cursor: pointer;
    font-size: inherit;
    font-family: inherit;
  }
</style>