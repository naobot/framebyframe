---
interface Props {
  heading: string;
  description: string;
  ctaHref: string;
  cover: string;
}

const { heading, description, cover, ctaHref } = Astro.props;
---

<section id="hero">
  <div class="image-side">
    <img src={cover} alt="" />
  </div>

  <div class="text-side">
    <div class="text-content">
      <h2>
        アニメ業界発、フェミニストとクィア当事者のアニメ業界人たちによる社会のことを考えるZINE
      </h2>
      <h1>{heading}</h1>
      <p>{description}</p>
      <a href={ctaHref} class="cta">→ More issues</a>
    </div>
  </div>
</section>

<style>
  #hero {
    display: flex;
    height: 100vh;
    overflow: hidden;
  }

  .image-side {
    flex: 1;
    clip-path: polygon(0 0, 92% 0, 100% 100%, 0 100%);
    overflow: hidden;
    flex-shrink: 0;
  }

  .image-side img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .text-side {
    width: 36%;
    flex-shrink: 0;
    background: #ffffff;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 1rem 2rem;
    /* overlap the diagonal edge so no gap shows */
    margin-left: -8%;
  }

  .text-content {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    max-width: 320px;

    h1, h2 {
      padding-left: 2rem;
      z-index: 5;
    }

    h1 {
      line-height: 1;
      font-weight: 800;
    }

    h2 {
      line-height: 1;
      color: #3e3e3e;
      font-weight: 200;
      font-size: 0.9rem;
      writing-mode: vertical-rl;
      max-height: 40vh;
    }

    .cta {
      color: #000;
      padding: 8px;
      text-transform: uppercase;
      font-weight: 800;
      letter-spacing: 2px;
      text-decoration: none;
    }
  }
</style>