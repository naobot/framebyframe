---
import heroImage from '../assets/IMG_9356.jpg';

interface Props {
  heading: string;
  description: string;
  ctaHref: string;
}

const { heading, description, ctaHref } = Astro.props;
---

<section id="hero">
  <div class="image-side">
    <img src={heroImage.src} alt="" />
  </div>

  <div class="text-side">
    <div class="text-content">
      <h1>{heading}</h1>
      <p>{description}</p>
      <a href={ctaHref} class="cta">More issues</a>
    </div>
  </div>
</section>

<style>
  #hero {
    display: flex;
    height: 100vh;
    overflow: hidden;
  }

  .image-side {
    flex: 1;
    clip-path: polygon(0 0, 92% 0, 100% 100%, 0 100%);
    overflow: hidden;
    flex-shrink: 0;
  }

  .image-side img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .text-side {
    width: 36%;
    flex-shrink: 0;
    background: #ffffff;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 2rem;
    /* overlap the diagonal edge so no gap shows */
    margin-left: -8%;
  }

  .text-content {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    max-width: 320px;
  }
</style>