{
  "base_url": "http://localhost:4321/",
  "assets_path": "public/assets/uploads",
  "data_path": "src/data",
  "collections": [
    {
      "name": "issues",
      "label": "Issues",
      "path": "src/content/issues",
      "orderable": true,
      "publishable": true,
      "fields": [
        { "name": "title", "label": "Title", "type": "text", "required": true },
        { "name": "publish_date", "label": "Publish Date", "type": "text", "required": false },
        { "name": "cover", "label": "Cover Photo", "type": "image", "required": false },
        { "name": "photos", "label": "Additional Photos", "type": "image-list", "required": false },
        { "name": "sample_pages", "label": "Sample Pages", "type": "image-list", "required": false },
        { "name": "buy_link", "label": "Buy Link", "type": "text", "required": false },
        { "name": "description", "label": "Description", "type": "rich-text", "required": false }
      ]
    }
  ],
  "singletons": [
    {
      "name": "contact",
      "label": "Contact",
      "path": "src/content/contact.md",
      "fields": [
        { "name": "title", "label": "Title", "type": "text", "required": true },
        { "name": "subtitle", "label": "Subtitle", "type": "text", "required": false }
      ]
    }
  ],
  "data_files": [
    {
      "path": "src/data/about.json",
      "label": "About",
      "fields": [
        {
          "name": "sections",
          "label": "Sections",
          "type": "list-of-objects",
          "fields": [
            { "name": "heading", "label": "Heading", "type": "text", "required": false },
            { "name": "subheading", "label": "Subheading", "type": "text", "required": false },
            { "name": "text", "label": "Text", "type": "rich-text", "required": false },
            { "name": "heading_en", "label": "Heading (EN)", "type": "text", "required": false },
            { "name": "subheading_en", "label": "Subheading (EN)", "type": "text", "required": false },
            { "name": "text_en", "label": "Text (EN)", "type": "rich-text", "required": false }
          ]
        }
      ]
    },
    {
      "path": "src/data/navigation.json",
      "label": "Navigation",
      "fields": [
        {
          "name": "items",
          "label": "Navigation Items",
          "type": "list-of-objects",
          "fields": [
            { "name": "name", "label": "Name", "type": "text", "required": true },
            { "name": "link", "label": "Link", "type": "text", "required": true }
          ]
        }
      ]
    },
    {
      "path": "src/data/contribute.json",
      "label": "Contribute",
      "fields": [
        { "name": "title", "label": "Title", "type": "text", "required": true },
        { "name": "subtitle", "label": "Subtitle", "type": "text", "required": false },
        { "name": "description", "label": "Description", "type": "rich-text", "required": false },
        { "name": "contribution_link", "label": "Contribution Link", "type": "text", "required": false },
        { "name": "contribution_button", "label": "Contribution Button Text", "type": "text", "required": false }
      ]
    },
    {
      "name": "shops",
      "label": "Shop List",
      "path": "src/data/shops.json",
      "fields": [
        { "name": "title", "label": "Title", "type": "text", "required": true },
        { "name": "subtitle", "label": "Subtitle", "type": "text", "required": false },
        { "name": "intro", "label": "Intro", "type": "rich-text", "required": false },
        { "name": "title_en", "label": "Title (EN)", "type": "text", "required": false },
        { "name": "subtitle_en", "label": "Subtitle (EN)", "type": "text", "required": false },
        { "name": "intro_en", "label": "Intro (EN)", "type": "rich-text", "required": false },
        {
          "name": "shops",
          "label": "Shops",
          "type": "list-of-objects",
          "fields": [
            { "name": "name", "label": "Shop Name", "type": "text", "required": true },
            { "name": "region", "label": "City / Region", "type": "text", "required": false },
            { "name": "address", "label": "Address", "type": "textarea", "required": false },
            { "name": "website", "label": "Website", "type": "text", "required": false }
          ]
        }
      ]
    },
    {
      "name": "news",
      "label": "News",
      "path": "src/data/news.json",
      "fields": [
        {
          "name": "items",
          "label": "News Items",
          "type": "list-of-objects",
          "fields": [
            { "name": "title", "label": "Heading", "type": "text", "required": true },
            { "name": "year", "label": "Year", "type": "text", "required": true },
            { "name": "month", "label": "Month", "type": "text", "required": false },
            { "name": "day", "label": "Day", "type": "text", "required": false },
            { "name": "date_note", "label": "Date Note (shown instead of the date)", "type": "text", "required": false },
            { "name": "photos", "label": "Photos", "type": "image-list", "required": false },
            { "name": "link", "label": "Link", "type": "text", "required": false },
            { "name": "description", "label": "Description", "type": "textarea", "required": false }
          ]
        }
      ]
    }
  ]
}